<?xml version="1.0" ?>
<robot name="scara">

  <link name="world"/> <!-- Add world link -->

  <joint name="base_x_slider" type="prismatic"> <!-- Add prismatic joint for base -->
    <parent link="world"/>
    <child link="base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/> <!-- Initial offset from world origin -->
    <axis xyz="1 0 0"/> <!-- Allow movement along X axis -->
    <limit lower="-1.0" upper="4.0" effort="100" velocity="0.5"/> <!-- Define movement limits -->
  </joint>

  <link name="base">
     <!-- Add collision/inertial for base -->
     <collision>
       <geometry> <box size="0.1 0.1 0.02"/> </geometry> <!-- Example small base collision -->
       <origin xyz="0 0 0.01" rpy="0 0 0"/>
     </collision>
     <inertial>
       <mass value="1.0"/>
       <origin xyz="0 0 0.01" rpy="0 0 0"/>
       <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
     </inertial>
     <!-- Visual for the base plate -->
     <visual>
       <geometry> <box size="0.1 0.1 0.02"/> </geometry>
       <origin xyz="0 0 0.01" rpy="0 0 0"/>
       <material name="dark_grey"> <color rgba="0.3 0.3 0.3 1"/> </material>
     </visual>
     <!-- Visual for the vertical riser (purely visual) -->
     <visual>
       <geometry>
         <!-- Cylinder height goes from top of base plate (z=0.02) up to joint1 origin (z=0.3) -->
         <cylinder length="0.28" radius="0.03" />
       </geometry>
       <!-- Position the center of the cylinder halfway up its length, starting from base plate top -->
       <!-- Center Z = base_top_z + length/2 = 0.02 + 0.28/2 = 0.16 -->
       <origin xyz="0 0 0.16" rpy="0 0 0" />
       <material name="grey"> <color rgba="0.5 0.5 0.5 1"/> </material>
     </visual>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base" /> <!-- Parent is now the sliding base -->
    <child link="link1" />
    <origin xyz="0 0 0.3" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0" />
  </joint>

  <link name="link1">
    <visual>
      <geometry>
        <box size="0.5 0.05 0.05" />
      </geometry>
      <origin xyz="0.25 0 0" rpy="0 0 0" />
      <material name="grey"/> <!-- Removed redundant material definition -->
    </visual>
    <collision>
      <geometry>
        <box size="0.5 0.05 0.05" />
      </geometry>
      <origin xyz="0.25 0 0" rpy="0 0 0" />
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0.25 0 0" rpy="0 0 0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1" />
    <child link="link2" />
    <origin xyz="0.5 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0" />
  </joint>

  <link name="link2">
    <visual>
      <geometry>
        <box size="0.4 0.05 0.05" />
      </geometry>
      <origin xyz="0.2 0 0" rpy="0 0 0" />
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.4 0.05 0.05" />
      </geometry>
      <origin xyz="0.2 0 0" rpy="0 0 0" />
    </collision>
    <inertial>
      <mass value="0.4"/>
      <origin xyz="0.2 0 0" rpy="0 0 0" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="joint3" type="prismatic">
    <parent link="link2" />
    <child link="end_effector" />
    <origin xyz="0.4 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-0.2" upper="0.2" effort="10" velocity="0.1" />
  </joint>

  <link name="end_effector">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.02" />
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.1" radius="0.02" />
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0" />
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
</robot>